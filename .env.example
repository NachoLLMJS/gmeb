# Create a Reddit "web app" at https://www.reddit.com/prefs/apps
# The redirect URI must match exactly. Local default:
# http://127.0.0.1:4173/auth/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://127.0.0.1:4173/auth/reddit/callback
# Generate a long random value. Never commit it.
SESSION_SECRET=
PORT=4173
